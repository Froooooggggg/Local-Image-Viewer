app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# === 本项目的补充忽略 ===

# 开发期的探针脚本、测试素材、临时产物（体积不大但没必要入库）
.scratch/

# 自动化测试截图（人工验证用）
.screenshots/

# 交接用的私有文档：内含开发机路径、设备序列号、局域网 IP、配对码等，
# 只留在本地，不入库（新增的交接文档也请放这里）
.private-docs/

# 旧版打包 / 数据备份（体积大且含个人数据）
*.tar
*.tar.gz

# 设备与服务的本机凭据，绝对不要入库
token.txt
*.token
secrets.*
local.properties

# Kotlin / Gradle 的本地缓存目录
/android/.kotlin/
/android/.gradle/
/captures/

# 本机开发环境脚本：写死了这台机器的 Flutter / SDK / JDK 路径，只留在本地。
# README 里给的是通用的 flutter / adb 命令，任何人装好 SDK 都能用。
dev-env.ps1
dev-env.cmd

# 旧的 IntelliJ 工程文件（项目已改名为 simple_gallery_viewer）
picture_checker.iml
demo_app.iml

# Gradle 在 android/ 下生成的报告等构建产物
# （android/.gitignore 只忽略了 .gradle/captures，没覆盖到 build/）
/android/build/